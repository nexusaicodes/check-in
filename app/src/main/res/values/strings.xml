<?xml version="1.0" encoding="utf-8"?>
<!--
    Casing: section and card titles are Title Case ("Daily Target", "Overall Stats"); everything a
    user reads as a line rather than a heading — row labels, buttons, help text, empty states — is
    sentence case ("Mid-session presence check", "Grant access"). The exceptions are the product name
    CheckIn, the "Check In"/"Check Out" actions it is named after, and the PRESENT/HALF DAY/ABSENT
    status badges, which are styled as badges rather than read as words.
-->
<resources>
    <!-- App Name. "CheckIn" is the product (matching the Play listing); "Check In" with a space is
         the action, and the two are not interchangeable — see nav_check_in and check_in below. -->
    <string name="app_name">CheckIn</string>

    <!-- Navigation -->
    <string name="nav_check_in">Check In</string>
    <string name="nav_attendance">Attendance</string>
    <string name="nav_reports">Reports</string>
    <string name="nav_settings">Settings</string>
    <string name="nav_licenses">Open Source</string>

    <!-- Check-In Screen -->
    <string name="check_in">Check In</string>
    <string name="check_out">Check Out</string>
    <string name="resume_session">Resume</string>
    <string name="checkin_paused_caption">Paused — verify your presence to resume</string>
    <string name="todays_sessions_summary">%1$s · %2$s today</string>
    <string name="session_in_progress">in progress</string>
    <plurals name="sessions_count">
        <item quantity="one">%d session</item>
        <item quantity="other">%d sessions</item>
    </plurals>
    <string name="status_present">PRESENT</string>
    <string name="status_half_day">HALF DAY</string>
    <string name="status_full_day">ABSENT</string>

    <!-- Selfie Capture -->
    <string name="selfie_capture">Capture</string>
    <string name="selfie_dismiss">Dismiss</string>
    <string name="selfie_face_detected">Face detected!</string>
    <string name="selfie_no_face">No face detected — try again</string>
    <string name="selfie_error">Capture failed — try again</string>
    <plurals name="selfie_attempts_remaining">
        <item quantity="one">%d more attempt, then device unlock</item>
        <item quantity="other">%d more attempts, then device unlock</item>
    </plurals>

    <!-- Biometric fallback. One gate serves check-in, check-out and re-auth, so the subtitle names
         the presence check rather than any one of them. -->
    <string name="biometric_title">Verify it\'s you</string>
    <string name="biometric_subtitle">Use your device unlock to verify your presence</string>
    <string name="biometric_use_device_unlock">Use device unlock</string>
    <string name="biometric_unavailable">Device unlock isn\'t available</string>

    <!-- Presence-check reminder (foreground service) -->
    <string name="reminder_channel_name">Presence Check</string>
    <string name="reminder_channel_description">Reminds you to confirm you\'re still checked in</string>
    <string name="reminder_title">Still checked in?</string>
    <!-- The clock has already stopped by the time this is read in pause mode, so the copy has to say
         so — the cost of ignoring it is unpaid time, not a lapse in etiquette. -->
    <string name="reminder_text_paused">Your timer is paused. Tap to verify your presence and resume.</string>
    <string name="reminder_text_running">Your timer is still running. Tap to verify your presence.</string>

    <!-- Engagement nudges -->
    <string name="engagement_channel_name">Encouragement</string>
    <string name="engagement_channel_description">Optional nudges encouraging you to check in</string>
    <string name="nudge_not_checked_in_title_a">Ready when you are</string>
    <string name="nudge_not_checked_in_body_a">You haven\'t checked in yet today. Tap to start your session.</string>
    <string name="nudge_not_checked_in_title_b">Start the clock?</string>
    <string name="nudge_not_checked_in_body_b">Your day hasn\'t started in CheckIn yet. Tap to check in now.</string>

    <!-- Empty / first-run states -->
    <string name="empty_checkin_title">Ready when you are</string>
    <string name="empty_reports_title">No completed days yet</string>
    <string name="empty_reports_message">Your charts, streaks, and totals appear here once your first tracked day is over.</string>
    <string name="empty_day_detail_title">No day selected</string>
    <string name="empty_day_detail_message">Tap a day in the calendar to see its sessions.</string>

    <!-- Accessibility -->
    <string name="cd_day_status">%1$d, %2$s</string>
    <string name="cd_expand_sessions">Show today\'s sessions</string>
    <string name="cd_collapse_sessions">Hide today\'s sessions</string>
    <string name="cd_month_split">Month split: %1$d present, %2$d half day, %3$d absent</string>
    <string name="cd_alltime_split">All-time split: %1$d present, %2$d half day, %3$d absent</string>
    <string name="cd_timer_gauge">%1$s worked of a %2$s target</string>
    <string name="cd_timer_gauge_met">%1$s worked — %2$s target met</string>

    <!-- Attendance Screen -->
    <string name="previous_month">Previous month</string>
    <string name="next_month">Next month</string>
    <string name="day_detail_title">Sessions on %1$s</string>
    <string name="stat_present">Present</string>
    <string name="stat_half_day">Half day</string>
    <string name="stat_full_day">Absent</string>
    <string name="stat_days_label">days tracked</string>
    <!-- The card follows the month the user has navigated to, so the label has to name it. -->
    <string name="stat_avg_this_month">Avg / day, %1$s</string>
    <string name="stat_avg_all_time">Avg / day, all time</string>

    <!-- Reports Screen -->
    <string name="overall_stats_title">Overall Stats</string>
    <string name="stat_tracking_since">Tracking since</string>
    <!-- Every day in the window, including days with no sessions — not "days I recorded". -->
    <string name="stat_total_tracked_days">Days since tracking started</string>
    <!-- Streaks count consecutive PRESENT days only; a half day breaks them. -->
    <string name="stat_current_streak">Current streak (target met)</string>
    <string name="stat_best_streak">Best streak (target met)</string>
    <string name="chart_daily_hours_title">Daily Hours</string>
    <!-- One line for the whole window, drawn at today's target: earlier days may have had another. -->
    <string name="chart_daily_hours_subtitle">Last %1$d days · dashed line = current %2$dh target</string>
    <string name="chart_split_title">All-Time Split</string>
    <string name="chart_monthly_title">Hours by Month</string>
    <string name="cd_daily_hours_chart">Daily hours over the last %1$d days. Best day %2$s. Current target %3$d hours.</string>
    <string name="cd_monthly_chart">Hours by month: %1$s</string>
    <plurals name="days_count">
        <item quantity="one">%d day</item>
        <item quantity="other">%d days</item>
    </plurals>
    <string name="export_title">Export Data</string>
    <string name="export_this_month">This month</string>
    <string name="export_all_time">All time</string>
    <string name="export_chooser_title">Export Attendance</string>
    <!-- Posted once the file exists and the share sheet is up; the user has not picked a target yet. -->
    <string name="export_success">Attendance CSV ready to share</string>
    <string name="export_nothing">No completed days to export yet</string>
    <string name="export_failed">Export failed: %1$s</string>

    <!-- Settings Screen -->
    <string name="settings_target_section">Daily Target</string>
    <plurals name="settings_daily_target">
        <item quantity="one">%1$d hour</item>
        <item quantity="other">%1$d hours</item>
    </plurals>
    <string name="settings_target_help">Past days keep the target they had.</string>
    <string name="settings_nudges_section">Notifications</string>
    <string name="settings_nudges_master">Check-in reminders</string>
    <string name="settings_nudges_master_help">Occasional reminders when you haven\'t checked in. Off by default, and each one below can be turned on separately.</string>
    <!-- Deliberately not under the master switch above: that one governs optional encouragement,
         this one governs how worked time is counted. -->
    <string name="settings_presence_check">Mid-session presence check</string>
    <string name="settings_presence_check_pauses">Pause timer until verified</string>
    <string name="settings_presence_check_help">Once partway through the day\'s target, a notification asks you to verify your presence. Checking in and out always ask, whatever this is set to.</string>
    <!-- Both outcomes, not just the active one: the cost of each answer is the substance of the choice. -->
    <string name="settings_presence_pauses_help">On: the time between the reminder and your verification isn\'t counted toward your hours. Off: your timer keeps running whether or not you answer.</string>
    <string name="settings_info_about">About %1$s</string>
    <string name="settings_info_dismiss">Got it</string>
    <string name="nudge_label_not_checked_in">Morning reminder</string>
    <!-- Deliberately vague about the time. The hour lives in NudgeConfig, and the pass that sends
         the nudge is an hourly deferrable job, so naming a clock time would promise a punctuality
         the app cannot keep — and would silently go stale if the rule were ever retuned. -->
    <string name="nudge_help_not_checked_in">Sent mid-morning on a day with no check-in yet. At most one reminder a day.</string>
    <string name="settings_debug_section">Nudge Harness (debug)</string>
    <string name="settings_debug_run_pass">Run pass</string>
    <string name="settings_debug_clear">Clear log</string>
    <string name="settings_debug_send">Force send: %1$s v%2$d</string>
    <string name="settings_debug_no_events">No engagement events recorded yet.</string>

    <!-- Notification permission warning. Everything the app does to keep you honest about a session
         goes through a notification, so losing the permission silently disables all of it. -->
    <string name="settings_notifications_off">Notifications are turned off</string>
    <string name="settings_notifications_off_help">Without them the running timer, the presence check and every reminder are silently disabled — a session can run all night with nothing to show for it. Your recorded hours are unaffected.</string>
    <string name="settings_notifications_off_action">Open notification settings</string>

    <!-- Diagnostics. Available in release builds on purpose: the failures this records are invisible
         everywhere else, and a user reporting one has no other way to say what happened. -->
    <string name="settings_diagnostics_section">Diagnostics</string>
    <string name="settings_diagnostics_help">Recent notification and background-service activity, kept on this device.</string>
    <string name="settings_diagnostics_show">Show recent activity</string>
    <string name="settings_diagnostics_hide">Hide recent activity</string>
    <string name="settings_diagnostics_empty">Nothing recorded yet.</string>

    <!-- About -->
    <string name="about_section">About</string>
    <string name="about_version">Version %1$s (build %2$d)</string>
    <string name="about_developer">Nexus AI Technology Labs</string>
    <string name="about_privacy_policy">Privacy policy</string>
    <string name="about_feedback">Send feedback</string>
    <string name="about_rate">Rate on Google Play</string>
    <string name="about_licenses">Open source licenses</string>
    <string name="about_open_link">Opens outside the app</string>
    <string name="about_no_email_app">No email app found. Address copied: %1$s</string>
    <string name="about_no_browser">No browser found. Link copied to the clipboard.</string>
    <string name="about_no_handler">Nothing on this device can open that.</string>

    <!-- Open source licenses -->
    <string name="licenses_intro">CheckIn is built on these projects. Grouped by upstream project rather than by artifact.</string>
    <!-- Named after the licence it opens: these buttons sit below every library card, far from any
         context. The text is bundled rather than linked because Apache-2.0 section 4(a) and the OFL
         both oblige the app to ship a copy, and an offline device could not fetch one. -->
    <string name="licenses_show_full_text">Show %1$s text</string>
    <string name="licenses_hide_full_text">Hide %1$s text</string>
    <string name="nav_back">Back</string>

    <!-- Notification (Foreground Service) -->
    <string name="notification_channel_name">Check-In Timer</string>
    <string name="notification_channel_description">Shows the active check-in timer</string>
    <string name="notification_title">Checked In</string>
    <!-- Running: the elapsed time is drawn by the platform's own chronometer in the timestamp slot,
         so the body must not print it too — it would appear twice, and the copy would be the stale
         one. Paused: there is no chronometer (it can only count forward), so the frozen time is
         printed here instead, which is what a stopped clock should look like. -->
    <string name="notification_running">Timing your session</string>
    <string name="notification_paused">%1$s · Paused — verify presence</string>
    <string name="notification_action_stop">Check Out</string>

    <!-- Camera prominent disclosure, shown before the camera permission request at the first
         check-in. The camera runs face *detection* — it looks for any face, it does not match one
         against an enrolled identity, so none of this may read as "selfie verification". -->
    <string name="camera_disclosure_title">Presence verification</string>
    <!-- The frame is written to app-private storage for the split second detection needs it, so the
         honest claim is "then deleted", not "never saved". -->
    <string name="camera_disclosure_message">Your front camera verifies your presence at check-in and check-out. Photos are checked on this device, then deleted. Never uploaded.</string>
    <string name="camera_disclosure_button">Continue</string>

    <!-- Recovery screen, shown only after the camera permission is refused -->
    <string name="camera_permission_title">Camera access needed</string>
    <string name="camera_permission_message">Check-in and check-out verify your presence with the front camera, so neither can run without it.</string>
    <string name="camera_permission_button">Grant access</string>
    <string name="presence_gate_cancel">Not now</string>
</resources>
