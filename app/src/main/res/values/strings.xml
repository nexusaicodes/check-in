    <!-- Permission gate. The camera runs face *detection* — it looks for any face, it does not match
         one against an enrolled identity, so this must not read as "selfie verification". -->
    <string name="permission_required_title">Permission Required</string>
    <string name="permission_gate_message">This app requires Camera and Notification permissions to function. The camera runs an on-device face check on every check-in and check-out, and the notification shows your running timer.</string>
    <string name="permission_button_grant">Grant Permissions</string>

    <!-- Camera prominent disclosure (shown before the camera permission request) -->
    <string name="camera_disclosure_title">Presence verification</string>
    <!-- The frame is written to app-private storage for the split second detection needs it, so the
         honest claim is "never kept", not "never saved". -->
    <string name="camera_disclosure_message">Check In uses your front camera only to verify your presence on this device when you check in or out. Each photo is processed on your device to detect a face, then deleted as soon as the check resolves — images are never kept, uploaded, or shared. Tap Continue to allow camera access.</string>
    <string name="camera_disclosure_button">Continue</string>
