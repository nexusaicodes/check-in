<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Excludes the sessions DB from cloud backup, and the prefs that only mean anything beside
         it. Applies below API 31 only; the app's minSdk is 34, so data_extraction_rules.xml is
         authoritative — mirrored here for hygiene, and it carries the reasoning. -->
    <exclude domain="database" path="_app" />
    <exclude domain="database" path="_app-shm" />
    <exclude domain="database" path="_app-wal" />
    <exclude domain="sharedpref" path="tracking_prefs.xml" />
    <exclude domain="sharedpref" path="checkin_timer_prefs.xml" />
</full-backup-content>
