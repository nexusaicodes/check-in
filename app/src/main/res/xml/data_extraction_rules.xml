<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- The sessions DB never leaves the device via Google cloud backup. -->
        <exclude domain="database" path="_app" />
        <exclude domain="database" path="_app-shm" />
        <exclude domain="database" path="_app-wal" />
        <!--
          And neither does the state that only means anything beside it. `tracking_start_date` is
          an index into the sessions table: restored without one, the app reports every day since
          that date as a day the user did not show up for — on the one screen they check their
          consistency in, with no UI to correct it. `checkin_timer_prefs` mirrors a live session
          for rendering, which likewise describes rows that were not restored.
        -->
        <exclude domain="sharedpref" path="tracking_prefs.xml" />
        <exclude domain="sharedpref" path="checkin_timer_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!--
          Included by default, and correctly so: a direct device-to-device transfer moves the DB
          too, so the tracking start still lands beside the sessions it indexes.
        -->
    </device-transfer>
</data-extraction-rules>
